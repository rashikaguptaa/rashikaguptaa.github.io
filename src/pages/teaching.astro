---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
import { teaching } from '../data/optional.js';
---
<Base title="Teaching" description={`Teaching by ${site.name}.`}>
  <div class="page">
    <h1>Teaching</h1>
    {teaching.length === 0 && <p>Add courses to <code>src/data/site.js</code> and they will appear here.</p>}
    <ul class="entries">
      {teaching.map((c) => (
        <li>
          <span class="entry-date">{c.term}</span>
          <div>
            <p class="entry-title">{c.course}</p>
            <p class="entry-meta">{[c.role, c.institution].filter(Boolean).join(', ')}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Base>
