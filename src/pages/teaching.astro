---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
import { teaching } from '../data/optional.js';
---
<Base title="Teaching" description={`Teaching by ${site.name}.`}>
  <div class="page">
    <h1>Teaching</h1>
    {teaching.length === 0 && <p>Add courses to <code>src/data/site.js</code> and they will appear here.</p>}
    <ul class="entries">
      {teaching.map((c) => (
        <li>
          <span class="entry-date">{c.term}</span>
          <div>
            <p class="entry-title">{c.course}</p>
            <p class="entry-meta">{[c.role, c.institution].filter(Boolean).join(', ')}</p>
            {c.detail && <p class="entry-meta">{c.detail}</p>}
            {c.courses?.length > 0 && (
              <ul class="teaching-courses">
                {c.courses.map((course) => <li>{course}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .teaching-courses { margin: 0.75rem 0 0; padding-left: 1.25rem; }
  .teaching-courses > li { display: list-item; padding: 0; border: 0; }
  .teaching-courses > li + li { margin-top: 0.35rem; }
</style>
