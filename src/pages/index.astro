---
import Base from '../layouts/Base.astro';
import ChainRule from '../components/ChainRule.astro';
import Links from '../components/Links.astro';
import Banner from '../components/Banner.astro';
import PubList from '../components/PubList.astro';
import { site, publications } from '../data/site.js';
import { posts, formatDate, isoDate } from '../data/posts.js';

const news = (site.news ?? []).slice(0, 4);
const selected = publications.filter((p) => p.selected);
const latest = posts.slice(0, 3);
---
<Base>
  <section class="hero">
    <div class="hero-text">
      <h1 class="name">{site.name}</h1>
      <p class="role">{site.position}<br />{site.affiliation}</p>
      <div class="bio">
        {site.bio.map((para) => <p>{para}</p>)}
      </div>
      <Links />
    </div>
    <img class="portrait" src={site.photo} alt={`Photo of ${site.name}`} width="280" height="340" />
  </section>

  <Banner />

  <ChainRule />

  {(news.length > 0 || selected.length > 0) && (
    <div class="home-grid">
      {news.length > 0 && (
        <section class="block">
          <h2>News</h2>
          <dl class="news">
            {news.map((n) => (
              <div>
                <dt>{n.date}</dt>
                <dd>{n.link ? <a href={n.link}>{n.text}</a> : n.text}</dd>
              </div>
            ))}
          </dl>
          {(site.news?.length ?? 0) > news.length && <p class="more"><a href="/about">All news</a></p>}
        </section>
      )}
      {selected.length > 0 && (
        <section class="block">
          <h2>Selected publications</h2>
          <PubList items={selected} />
          <p class="more"><a href="/publications">All publications and talks</a></p>
        </section>
      )}
    </div>
  )}

  {latest.length > 0 && (
    <section class="block">
      <h2>From the blog</h2>
      <ul class="post-cards">
        {latest.map((p) => (
          <li>
            <time datetime={isoDate(p.date)}>{formatDate(p.date)}</time>
            <a class="post-link" href={p.url}>{p.title}</a>
            {p.description && <p class="post-desc">{p.description}</p>}
          </li>
        ))}
      </ul>
      <p class="more"><a href="/blog">All posts</a></p>
    </section>
  )}

  <section class="block contact" id="contact">
    <h2>Contact</h2>
    <div class="contact-grid">
      {site.email && (
        <div>
          <p class="contact-label">Email</p>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
      )}
      {site.address && (
        <div>
          <p class="contact-label">Address</p>
          <p>{site.address}</p>
        </div>
      )}
      <div>
        <p class="contact-label">Profiles</p>
        <Links noEmail />
      </div>
    </div>
  </section>
</Base>
