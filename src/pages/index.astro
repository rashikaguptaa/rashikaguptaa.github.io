---
import Base from '../layouts/Base.astro';
import ChainRule from '../components/ChainRule.astro';
import Links from '../components/Links.astro';
import Banner from '../components/Banner.astro';
import PubList from '../components/PubList.astro';
import { site, publications } from '../data/site.js';

const selected = publications.filter((p) => p.selected);
---
<Base>
  <section class="hero">
    <div class="hero-text">
      <h1 class="name">{site.name}</h1>
      <p class="role">{site.position}<br />{site.affiliation}</p>
      <div class="bio">
        {site.bio.map((para) => <p>{para}</p>)}
      </div>
      <Links />
    </div>
    <img class="portrait" src={site.photo} alt={`Photo of ${site.name}`} width="280" height="340" />
  </section>

  <Banner />

  <ChainRule />

  {selected.length > 0 && (
    <section class="block">
      <h2>Selected publications</h2>
      <PubList items={selected} />
      <p class="more"><a href="/publications">All publications and talks</a></p>
    </section>
  )}

  <section class="block contact" id="contact">
    <h2>Contact</h2>
    <div class="contact-grid">
      {site.email && (
        <div>
          <p class="contact-label">Email</p>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
      )}
      {site.address && (
        <div>
          <p class="contact-label">Address</p>
          <p>{site.address}</p>
        </div>
      )}
      <div>
        <p class="contact-label">Profiles</p>
        <Links noEmail />
      </div>
    </div>
  </section>
</Base>
