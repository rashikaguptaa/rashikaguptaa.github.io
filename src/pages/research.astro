---
import Base from '../layouts/Base.astro';
import ResearchArt from '../components/ResearchArt.astro';
import { site } from '../data/site.js';
import { research, researchIntro } from '../data/optional.js';

const sections = [
  {
    id: 'doctoral-thesis',
    heading: 'Doctoral thesis',
    intro: 'My dissertation, “Dynamic Decision Making in Intralogistics and E-Mobility Systems,” comprises three essays on human–robot collaborative warehouse operations and EV charging.',
    items: research.filter((r) => r.category === 'thesis'),
  },
  {
    id: 'published-research',
    heading: 'Other published research',
    items: research.filter((r) => r.category === 'publication'),
  },
];
---
<Base title="Research">
  <div class="page">
    <h1>Research</h1>
    {researchIntro && <p class="lede">{researchIntro}</p>}
    {site.interests?.length > 0 && (
      <div class="interest-block">
        <h2 class="small-heading">Research interests</h2>
        <ul class="tags">
          {site.interests.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    )}
    {sections.filter((section) => section.items.length > 0).map((section) => (
      <section class="block" aria-labelledby={section.id}>
        <h2 id={section.id}>{section.heading}</h2>
        {section.intro && <p class="lede">{section.intro}</p>}
        <div class="areas">
          {section.items.map((r) => (
            <article class="area">
              <div class="area-art">
                {r.image ? <img src={r.image} alt="" loading="lazy" /> : <ResearchArt kind={r.art} />}
              </div>
              <div class="area-body">
                {r.label && <p class="small-heading">{r.label}</p>}
                <h3>{r.title}</h3>
                <p>{r.text}</p>
                {r.methods?.length > 0 && (
                  <ul class="tags" aria-label="Methods">
                    {r.methods.map((m) => <li>{m}</li>)}
                  </ul>
                )}
                {r.link && <p class="more"><a href={r.link}>View publication</a></p>}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .area h3 { margin: 0 0 0.5rem; font-size: 1.4rem; font-weight: 400; }
  .area-body > .small-heading { margin-bottom: 0.4rem; }
</style>
