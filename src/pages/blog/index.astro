---
import Base from '../../layouts/Base.astro';
import { posts, formatDate, isoDate } from '../../data/posts.js';
---
<Base title="Blog" description="Notes on Markov decision processes, queueing models and operations research.">
  <div class="page">
    <h1>Blog</h1>
    <p class="lede">
      Notes on Markov decision processes, queueing models and the operations problems I work on.
      Posts include full proofs and short Python checks.
      <a class="feed-link" href="/rss.xml">RSS feed</a>
    </p>
    {posts.length === 0 && <p>No posts yet.</p>}
    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <time datetime={isoDate(p.date)}>{formatDate(p.date)}</time>
          <div>
            <a class="post-link" href={p.url}>{p.title}</a>
            {p.description && <p class="post-desc">{p.description}</p>}
            <p class="post-info">
              {p.minutesRead && <span>{p.minutesRead} min read</span>}
              {p.tags.length > 0 && <span>{p.tags.join(' · ')}</span>}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Base>
