---
import Base from '../../layouts/Base.astro';

// Every .md file in this folder is a post.
const posts = Object.values(import.meta.glob('./*.md', { eager: true }))
  .map((p) => ({ ...p.frontmatter, url: p.url }))
  .sort((a, b) => new Date(b.date) - new Date(a.date));
const fmt = (d) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Blog">
  <div class="page">
    <h1>Blog</h1>
    {posts.length === 0 && <p>No posts yet.</p>}
    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <time datetime={p.date}>{fmt(p.date)}</time>
          <a href={p.url}>{p.title}</a>
        </li>
      ))}
    </ul>
  </div>
</Base>
