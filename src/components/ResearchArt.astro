---
// Line drawings for research areas, in the same style as the home page chain.
const { kind } = Astro.props;
---
<svg class="art" viewBox="0 0 320 200" role="img" aria-hidden="true">
  <rect class="art-bg" x="0" y="0" width="320" height="200" rx="4" />
  {kind === 'platoon' && (
    <g>
      <line class="art-road" x1="16" y1="138" x2="304" y2="138" />
      <line class="art-lane" x1="16" y1="160" x2="304" y2="160" />
      {[40, 128, 216].map((x, i) => (
        <g>
          <rect class="art-line" x={x} y="96" width="46" height="34" rx="2" />
          <path class="art-line" d={`M${x + 46},106 h16 l10,12 v12 h-26`} />
          <circle class="art-fill" cx={x + 12} cy="134" r="5" />
          <circle class="art-fill" cx={x + 56} cy="134" r="5" />
          {i < 2 && <path class="art-accent" d={`M${x + 76},88 Q${x + 94},70 ${x + 112},88`} />}
        </g>
      ))}
      <circle class="art-state" cx="148" cy="79" r="4" />
      <text class="art-label" x="160" y="186" text-anchor="middle">platoon formation</text>
    </g>
  )}
  {kind === 'warehouse' && (
    <g>
      {[0, 1, 2, 3].map((r) =>
        [0, 1, 2, 3, 4].map((c) => (
          <rect class="art-rack" x={40 + c * 50} y={32 + r * 36} width="34" height="18" rx="1" />
        ))
      )}
      <path class="art-accent" d="M28,50 H90 V122 H190 V58 H262" />
      <rect class="art-robot" x="182" y="114" width="16" height="16" rx="3" />
      <circle class="art-state" cx="262" cy="58" r="5" />
      <text class="art-label" x="160" y="186" text-anchor="middle">robot routing</text>
    </g>
  )}
  {kind === 'ev' && (
    <g>
      <rect class="art-line" x="232" y="56" width="42" height="84" rx="4" />
      <rect class="art-fill-soft" x="240" y="66" width="26" height="18" rx="2" />
      <path class="art-accent" d="M253,94 l-7,14 h9 l-5,14" />
      <path class="art-line" d="M274,110 q22,0 22,24 v18" />
      {[40, 104, 168].map((x, i) => (
        <g>
          <path class="art-line" d={`M${x},136 v-12 l10,-12 h30 l10,12 v12 z`} />
          <circle class="art-fill" cx={x + 12} cy="138" r="5" />
          <circle class="art-fill" cx={x + 40} cy="138" r="5" />
          {i === 2 && <circle class="art-state" cx={x + 26} cy="104" r="4" />}
        </g>
      ))}
      <line class="art-road" x1="16" y1="148" x2="304" y2="148" />
      <text class="art-label" x="160" y="186" text-anchor="middle">admission and charging</text>
    </g>
  )}
</svg>
