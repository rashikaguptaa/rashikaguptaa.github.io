---
// Rotating photo banner with captions. Hidden when the list is empty.
import { banner } from '../data/optional.js';
---
{banner.length > 0 && (
  <section class="banner" aria-label="Photos" data-banner>
    <div class="banner-frame">
      {banner.map((b, i) => (
        <figure class={`banner-slide${i === 0 ? ' is-active' : ''}`} aria-hidden={i === 0 ? 'false' : 'true'}>
          <img src={b.src} alt={b.caption} loading={i === 0 ? 'eager' : 'lazy'} />
          <figcaption>{b.caption}</figcaption>
        </figure>
      ))}
    </div>
    {banner.length > 1 && (
      <div class="banner-controls">
        <button type="button" class="banner-prev" aria-label="Previous photo">‹</button>
        <div class="banner-dots">
          {banner.map((_, i) => (
            <button type="button" class={`banner-dot${i === 0 ? ' is-active' : ''}`} aria-label={`Show photo ${i + 1}`} data-i={i} />
          ))}
        </div>
        <button type="button" class="banner-next" aria-label="Next photo">›</button>
      </div>
    )}
  </section>
)}

<script>
  const root = document.querySelector('[data-banner]');
  if (root) {
    const slides = [...root.querySelectorAll('.banner-slide')];
    const dots = [...root.querySelectorAll('.banner-dot')];
    let current = 0;
    let timer;
    const show = (n) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        s.classList.toggle('is-active', i === current);
        s.setAttribute('aria-hidden', String(i !== current));
      });
      dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
    };
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = () => {
      if (!reduce && slides.length > 1) timer = setInterval(() => show(current + 1), 6000);
    };
    const stop = () => clearInterval(timer);
    root.querySelector('.banner-prev')?.addEventListener('click', () => { stop(); show(current - 1); });
    root.querySelector('.banner-next')?.addEventListener('click', () => { stop(); show(current + 1); });
    dots.forEach((d) => d.addEventListener('click', () => { stop(); show(Number(d.dataset.i)); }));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', () => { stop(); start(); });
    start();
  }
</script>
